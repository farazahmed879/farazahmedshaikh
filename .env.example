# Copy this file to .env.local and fill in the values.
# Never put real credentials in this file — it is committed to git.

# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/Portfolio?retryWrites=true&w=majority

# Long random string used to sign the admin session cookie (32+ chars)
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Public URL of the site (used for SEO metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: raises the GitHub API rate limit for the repos section
# GITHUB_TOKEN=

# Admin login: there are no env vars for it. On first run an admin account
# (username "admin", password "admin") is created in MongoDB — sign in at
# /admin and change it under "Account & password".
